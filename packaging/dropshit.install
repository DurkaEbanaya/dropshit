post_install() {
    systemctl daemon-reload >/dev/null 2>&1 || :
    systemctl enable dropshit-restore.service >/dev/null 2>&1 || :
}
post_upgrade() { systemctl daemon-reload >/dev/null 2>&1 || :; }
pre_remove() { /bin/sh /usr/share/dropshit/clear-installed-rules.sh; }
post_remove() { systemctl daemon-reload >/dev/null 2>&1 || :; }
